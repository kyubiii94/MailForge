# Clé API Gemini (Google AI) - requise pour l'analyse IA (ADN de marque, amélioration de texte, design email)
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — optionnel : palette couleurs après crawl (vision sur images hero/OG + CSS/HTML).
# Les images sont téléchargées côté serveur puis envoyées au modèle (meilleure fidélité e-commerce).
# Sans cette clé : heuristique CSS/HTML uniquement.
# OPENAI_PALETTE_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Modèle OpenAI pour les templates HTML (fallback si Gemini renvoie du JSON cassé). gpt-4o conseillé pour les grosses réponses.
# OPENAI_TEMPLATE_MODEL=gpt-4o-mini

# Base de données Neon PostgreSQL - requise pour la persistance des campagnes
# Obtenir une URL : https://console.neon.tech
DATABASE_URL=

# Auth.js — secret de signature des sessions (obligatoire)
# Générer : openssl rand -base64 32
AUTH_SECRET=XgQamhyO8gwKIZwwjaaFwqElQrJbFLhDthgDNyW0VsA=

# Vercel Blob (uniquement en prod sur Vercel) - créé automatiquement quand vous ajoutez un Blob Store dans Storage
# BLOB_READ_WRITE_TOKEN=
